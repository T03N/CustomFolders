<Page x:Class="CustomFolders.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:CustomFolders.Presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Required" RequestedTheme="Dark"
      Background="#1A1A1A">

  <Page.Resources>
    <!-- ── Colours ── -->
    <SolidColorBrush x:Key="SidebarBg"   Color="#252525"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#404040"/>
    <SolidColorBrush x:Key="AccentBlue"  Color="#007ACC"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#28A745"/>
    <SolidColorBrush x:Key="InputBg"     Color="#3A3A3A"/>
    <SolidColorBrush x:Key="InputBorder" Color="#555555"/>
    <SolidColorBrush x:Key="LabelColor"  Color="#C0C0C0"/>
    <SolidColorBrush x:Key="TitleColor"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HintColor"   Color="#888888"/>
    <SolidColorBrush x:Key="InfoBg"      Color="#2D4A57"/>
    <SolidColorBrush x:Key="InfoBorder"  Color="#0EA5E9"/>
    <SolidColorBrush x:Key="InfoText"    Color="#7DD3FC"/>

    <!-- ── PANEL TITLE style ── -->
    <Style x:Key="PanelTitle" TargetType="TextBlock">
      <Setter Property="FontSize"         Value="11"/>
      <Setter Property="FontWeight"       Value="SemiBold"/>
      <Setter Property="Foreground"       Value="{StaticResource TitleColor}"/>
      <Setter Property="CharacterSpacing" Value="80"/>
      <Setter Property="Margin"           Value="0,0,0,12"/>
    </Style>

    <!-- ── CONTROL LABEL style ── -->
    <Style x:Key="ControlLabel" TargetType="TextBlock">
      <Setter Property="FontSize"   Value="11"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{StaticResource LabelColor}"/>
      <Setter Property="Margin"     Value="0,0,0,6"/>
    </Style>

    <!-- ── MODERN INPUT style ── -->
    <Style x:Key="ModernInput" TargetType="TextBox">
      <Setter Property="Background"      Value="{StaticResource InputBg}"/>
      <Setter Property="BorderBrush"     Value="{StaticResource InputBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground"      Value="{StaticResource TitleColor}"/>
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="Padding"         Value="10,8"/>
      <Setter Property="CornerRadius"    Value="6"/>
    </Style>

    <!-- ── MODERN BUTTON style ── -->
    <Style x:Key="ModernBtn" TargetType="Button">
      <Setter Property="Background"          Value="{StaticResource AccentBlue}"/>
      <Setter Property="Foreground"          Value="#FFFFFF"/>
      <Setter Property="FontSize"            Value="13"/>
      <Setter Property="FontWeight"          Value="Medium"/>
      <Setter Property="Padding"             Value="16,10"/>
      <Setter Property="CornerRadius"        Value="6"/>
      <Setter Property="BorderThickness"     Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- ── OPTION BUTTON (unselected) ── -->
    <Style x:Key="OptionBtn" TargetType="Button">
      <Setter Property="Background"          Value="#3A3A3A"/>
      <Setter Property="Foreground"          Value="#C0C0C0"/>
      <Setter Property="FontSize"            Value="13"/>
      <Setter Property="FontWeight"          Value="Medium"/>
      <Setter Property="Padding"             Value="12,10"/>
      <Setter Property="CornerRadius"        Value="8"/>
      <Setter Property="BorderThickness"     Value="2"/>
      <Setter Property="BorderBrush"         Value="#555555"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- ── OPTION BUTTON (selected) ── -->
    <Style x:Key="OptionBtnSelected" TargetType="Button">
      <Setter Property="Background"          Value="{StaticResource AccentBlue}"/>
      <Setter Property="Foreground"          Value="#FFFFFF"/>
      <Setter Property="FontSize"            Value="13"/>
      <Setter Property="FontWeight"          Value="Medium"/>
      <Setter Property="Padding"             Value="12,10"/>
      <Setter Property="CornerRadius"        Value="8"/>
      <Setter Property="BorderThickness"     Value="2"/>
      <Setter Property="BorderBrush"         Value="{StaticResource AccentBlue}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- ── UPLOAD BUTTON ── -->
    <Style x:Key="UploadBtn" TargetType="Button">
      <Setter Property="Background"          Value="#3A3A3A"/>
      <Setter Property="Foreground"          Value="#C0C0C0"/>
      <Setter Property="FontSize"            Value="13"/>
      <Setter Property="Padding"             Value="12,10"/>
      <Setter Property="CornerRadius"        Value="8"/>
      <Setter Property="BorderThickness"     Value="2"/>
      <Setter Property="BorderBrush"         Value="#555555"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- ── SUCCESS BUTTON ── -->
    <Style x:Key="SuccessBtn" TargetType="Button">
      <Setter Property="Background"          Value="{StaticResource AccentGreen}"/>
      <Setter Property="Foreground"          Value="#FFFFFF"/>
      <Setter Property="FontSize"            Value="13"/>
      <Setter Property="FontWeight"          Value="Medium"/>
      <Setter Property="Padding"             Value="16,12"/>
      <Setter Property="CornerRadius"        Value="6"/>
      <Setter Property="BorderThickness"     Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="FlatPivotStyle" TargetType="Pivot">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <DataTemplate x:Key="EmojiTemplate">
        <Grid Width="36" Height="36">
            <TextBlock Text="{Binding}" 
                       FontSize="20" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>
  </Page.Resources>

  <!-- ═══════════════════════════════════════════════════════════════════
       ROOT — toolbar + workspace
       ═══════════════════════════════════════════════════════════════════ -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/> <!-- Top toolbar -->
      <RowDefinition Height="*"/> <!-- Workspace   -->
    </Grid.RowDefinitions>

    <!-- ── TOP TOOLBAR ─────────────────────────────────────────────── -->
    <Border Grid.Row="0"
            Background="#2A2A2A"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Margin="24,0">
        <TextBlock Text="PleasantFold"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TitleColor}"/>
        <TextBlock Text="  Professional Folder Icon Editor"
                   FontSize="12"
                   Foreground="#A0A0A0"
                   VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- ── WORKSPACE (3 columns) ────────────────────────────────────── -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/> <!-- Left sidebar  -->
        <ColumnDefinition Width="*"/>   <!-- Canvas        -->
        <ColumnDefinition Width="320"/> <!-- Right sidebar -->
      </Grid.ColumnDefinitions>

      <!-- ══════════════════════════════════════════════════════════════
           LEFT SIDEBAR
           ══════════════════════════════════════════════════════════════ -->
      <Border Grid.Column="0"
              Background="{StaticResource SidebarBg}"
              BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <!-- Project section -->
            <Border Padding="20"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="0,0,0,1">
              <StackPanel>
                <TextBlock Text="PROJECT" Style="{StaticResource PanelTitle}"/>
                <TextBlock Text="TARGET FOLDER" Style="{StaticResource ControlLabel}"/>
                <Button x:Name="SelectFolderBtn" IsEnabled="False"
                        Content="Select Folder"
                        Style="{StaticResource ModernBtn}"
                        Click="SelectFolderBtn_Click"/>

                <!-- Selected folder path indicator -->
                <Border x:Name="SelectedFolderPanel"
                        Visibility="Collapsed"
                        Margin="0,10,0,0"
                        Padding="12"
                        CornerRadius="6"
                        Background="{StaticResource InfoBg}"
                        BorderBrush="{StaticResource InfoBorder}"
                        BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="SELECTED FOLDER"
                               FontSize="10"
                               Foreground="{StaticResource InfoText}"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="SelectedFolderText"
                               FontSize="12"
                               Foreground="{StaticResource InfoText}"
                               TextWrapping="WrapWholeWords"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- Platform section -->
            <Border Padding="20"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="0,0,0,1">
              <StackPanel>
                <TextBlock Text="FOLDER STYLE" Style="{StaticResource PanelTitle}"/>
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="BtnMacOs"
                          Content="Mac style"
                          Grid.Column="0"
                          Style="{StaticResource OptionBtn}"
                          Click="BtnMacOs_Click"/>
                  <Button x:Name="BtnWindows"
                          Content="Windows style"
                          Grid.Column="1"
                          Style="{StaticResource OptionBtnSelected}"
                          Click="BtnWindows_Click"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Style Variants section -->
            <Border Padding="20"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="0,0,0,1">
              <StackPanel>
                <TextBlock Text="STYLE VARIANTS" Style="{StaticResource PanelTitle}"/>
                <ItemsControl x:Name="VariantList">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="6"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:VariantButtonItem">
                      <Button Content="{Binding Label}"
                              Tag="{Binding VariantKey}"
                              Style="{Binding ButtonStyle}"
                              Click="VariantBtn_Click"
                              HorizontalAlignment="Stretch"
                              Padding="10,8"
                              FontSize="12"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- ══════════════════════════════════════════════════════════════
           CENTRE — Preview canvas
           ══════════════════════════════════════════════════════════════ -->
      <Grid Grid.Column="1" Background="#1A1A1A">
        <!-- Outer card -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#2A2A2A"
                CornerRadius="16"
                Padding="32"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1">
          <Grid Width="256" Height="256">
            <!-- Skia preview control (checkerboard drawn natively) -->
            <local:FolderPreviewControl x:Name="FolderPreview"
                                        Width="256"
                                        Height="256"/>
          </Grid>
        </Border>
      </Grid>

      <!-- ══════════════════════════════════════════════════════════════
           RIGHT SIDEBAR
           ══════════════════════════════════════════════════════════════ -->
      <Border Grid.Column="2" IsHitTestVisible="False" Opacity="0.65"
              Background="{StaticResource SidebarBg}"
              BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <!-- Icon section -->
            <Border Padding="20"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="0,0,0,1">
              <StackPanel>
                <TextBlock Text="ICON" Style="{StaticResource PanelTitle}"/>

                <!-- Online search -->
                <TextBlock Text="SEARCH ONLINE" Style="{StaticResource ControlLabel}"/>
                <Grid ColumnSpacing="8" Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="SearchBox"
                           Grid.Column="0"
                           PlaceholderText="folder, heart…"
                           Style="{StaticResource ModernInput}"
                           KeyDown="SearchBox_KeyDown"/>
                  <Button Content="Search"
                          Grid.Column="1"
                          Click="SearchBtn_Click"
                          Style="{StaticResource ModernBtn}"
                          Padding="10,8"
                          HorizontalAlignment="Stretch"/>
                </Grid>
                <TextBlock Text="Search Flaticon, then check the artwork license. Import PNG, JPEG or BMP."
                           FontSize="11"
                           Foreground="{StaticResource HintColor}"
                           TextWrapping="WrapWholeWords"
                           Margin="0,0,0,16"/>

                <!-- Text / Emoji icon overlay -->
                <TextBlock Text="TEXT / EMOJI OVERLAY" Style="{StaticResource ControlLabel}"/>
                <Grid ColumnSpacing="8" Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="EmojiIconBox" IsEnabled="False"
                           PlaceholderText="Enter text or emoji..."
                           Style="{StaticResource ModernInput}"
                           TextChanged="EmojiIconBox_TextChanged"
                           Grid.Column="0"/>
                  <Button Content="😀"
                          Grid.Column="1"
                          Style="{StaticResource OptionBtn}"
                          Padding="12,6"
                          ToolTipService.ToolTip="Pick an Emoji">
                    <Button.Flyout>
                       <Flyout x:Name="EmojiFlyout" 
                               Placement="Bottom"
                               Opened="OnEmojiFlyoutOpened">
                          <Flyout.FlyoutPresenterStyle>
                             <Style TargetType="FlyoutPresenter">
                                <Setter Property="Background" Value="#1A1A1A"/>
                                <Setter Property="BorderBrush" Value="#333333"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="12"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinWidth" Value="320"/>
                                <Setter Property="MaxWidth" Value="320"/>
                                <Setter Property="MinHeight" Value="400"/>
                                <Setter Property="MaxHeight" Value="400"/>
                             </Style>
                          </Flyout.FlyoutPresenterStyle>
                          <Grid>
                             <Pivot x:Name="EmojiPickerPivot" 
                                    Style="{StaticResource FlatPivotStyle}">
                                <!-- Items will be added in code-behind via EmojiData.GetCategories() -->
                             </Pivot>
                          </Grid>
                       </Flyout>
                    </Button.Flyout>
                  </Button>
                </Grid>

                <!-- Upload custom icon -->
                <TextBlock Text="UPLOAD CUSTOM" Style="{StaticResource ControlLabel}"/>
                <Button Content="Choose Icon File…"
                        Style="{StaticResource UploadBtn}"
                        Click="PickIconFile_Click"/>
                <TextBlock x:Name="PickedIconLabel"
                           Text="No file selected"
                           FontSize="11"
                           Foreground="{StaticResource HintColor}"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>

            <!-- Text label section -->
            <Border Padding="20"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="0,0,0,1">
              <StackPanel>
                <TextBlock Text="TEXT LABEL" Style="{StaticResource PanelTitle}"/>
                <TextBox x:Name="TextLabelBox" IsEnabled="False"
                         PlaceholderText="Enter folder name…"
                         MaxLength="20"
                         Style="{StaticResource ModernInput}"
                         TextChanged="TextLabelBox_TextChanged"/>
              </StackPanel>
            </Border>

            <!-- Adjustments section -->
            <Border Padding="20"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="0,0,0,1">
              <StackPanel>
                <TextBlock Text="ADJUSTMENTS" Style="{StaticResource PanelTitle}"/>

                <!-- Match theme colours -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                  <CheckBox x:Name="AdjustColorCheck" IsEnabled="False"
                            IsChecked="True"
                            Checked="AdjustColor_Changed"
                            Unchecked="AdjustColor_Changed"/>
                  <TextBlock Text="Match theme colors"
                             FontSize="13"
                             Foreground="{StaticResource LabelColor}"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Icon Scale -->
                <StackPanel Margin="0,0,0,16">
                  <Grid Margin="0,0,0,6">
                    <TextBlock Text="ICON SCALE"
                               FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource LabelColor}"/>
                    <TextBlock x:Name="ScaleLabel"
                               Text="100%"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBlue}"
                               HorizontalAlignment="Right"/>
                  </Grid>
                  <Slider x:Name="ScaleSlider" IsEnabled="False"
                          Minimum="0.5" Maximum="2" Value="1" StepFrequency="0.1"
                          ValueChanged="ScaleSlider_ValueChanged"/>
                </StackPanel>

                <!-- Icon Position Y -->
                <StackPanel Margin="0,0,0,16">
                  <Grid Margin="0,0,0,6">
                    <TextBlock Text="ICON POSITION"
                               FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource LabelColor}"/>
                    <TextBlock x:Name="IconPosLabel"
                               Text="0px"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBlue}"
                               HorizontalAlignment="Right"/>
                  </Grid>
                  <Slider x:Name="IconOffsetSlider" IsEnabled="False"
                          Minimum="-100" Maximum="100" Value="0" StepFrequency="1"
                          ValueChanged="IconOffsetSlider_ValueChanged"/>
                </StackPanel>

                <!-- Text Position Y -->
                <StackPanel>
                  <Grid Margin="0,0,0,6">
                    <TextBlock Text="TEXT POSITION"
                               FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource LabelColor}"/>
                    <TextBlock x:Name="TextPosLabel"
                               Text="0px"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBlue}"
                               HorizontalAlignment="Right"/>
                  </Grid>
                  <Slider x:Name="TextOffsetSlider" IsEnabled="False"
                          Minimum="-100" Maximum="100" Value="0" StepFrequency="1"
                          ValueChanged="TextOffsetSlider_ValueChanged"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Export section -->
            <Border x:Name="ExportSection"
                    Padding="20"
                    Visibility="Visible">
              <StackPanel>
                <TextBlock Text="EXPORT &amp; SAVE" Style="{StaticResource PanelTitle}"/>

                <Button x:Name="ExportImageBtn" IsEnabled="False"
                        Content="Export as Image..."
                        Style="{StaticResource ModernBtn}"
                        Margin="0,0,0,10"
                        Click="ExportImageBtn_Click"/>

                <Button x:Name="ApplyBtn"
                        Content="Apply to Folder"
                        Style="{StaticResource SuccessBtn}"
                        Click="ApplyBtn_Click"
                        IsEnabled="False"/>

                <TextBlock Text="Applies to Windows folders. Imported artwork may have its own license."
                           FontSize="11"
                           Foreground="{StaticResource HintColor}"
                           TextWrapping="WrapWholeWords"
                           Margin="0,8,0,0"/>

                <!-- Status feedback -->
                <Border x:Name="StatusPanel"
                        Visibility="Collapsed"
                        Margin="0,10,0,0"
                        Padding="12"
                        CornerRadius="6"
                        BorderThickness="1">
                  <TextBlock x:Name="StatusText"
                             FontSize="12"
                             TextWrapping="WrapWholeWords"/>
                </Border>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Border>

    </Grid>
  </Grid>
</Page>
